{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/publish-config.schema.json",
  "title": "PublishConfig",
  "description": "Configuration schema for NPM package publisher",
  "type": "object",

  "properties": {
    "packages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "List of package names to include in the publication",
      "examples": [["@fluixi/core", "@fluixi/reactive", "@fluixi/utils"]]
    },

    "excluded": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Directory paths or patterns to exclude from package discovery",
      "examples": [["internal", "examples", "test-packages"]]
    },

    "excluded_packages": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Package names explicitly excluded from build and publication",
      "examples": [["@fluixi/experimental", "@fluixi/internal"]]
    },

    "buildConfigFile": {
      "type": "string",
      "description": "Path to an additional build configuration file to merge with command line options",
      "examples": ["publish-config.json", "config/publish.json"]
    },

    "global_build": {
      "type": "boolean",
      "default": true,
      "description": "Enable global build mode - runs a workspace-wide build before publishing"
    },

    "package_build": {
      "type": "boolean",
      "default": true,
      "description": "Enable per-package build mode - builds each package individually before publishing"
    },

    "type": {
      "type": "string",
      "enum": ["major", "minor", "patch"],
      "default": "patch",
      "description": "Semantic version increment type",
      "examples": ["patch", "minor", "major"]
    },

    "tag": {
      "type": "string",
      "default": "latest",
      "description": "NPM distribution tag for the publication",
      "examples": ["latest", "next", "beta", "alpha", "canary"]
    },

    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?$",
      "description": "Base version to increment from (semver format). If not provided, uses last published version",
      "examples": ["1.0.0", "2.1.3", "0.0.1"]
    },

    "suffix": {
      "type": "string",
      "default": "",
      "description": "Optional suffix appended to the version (e.g., 'beta', 'rc.1', 'alpha.2')",
      "examples": ["beta", "rc.1", "alpha", "canary"]
    },

    "registry": {
      "type": "string",
      "format": "uri",
      "description": "Custom NPM registry URL. If not provided, uses default npm registry",
      "examples": [
        "https://registry.npmjs.org",
        "https://npm.pkg.github.com",
        "https://us-central1-npm.pkg.dev/project/repo"
      ]
    },

    "content": {
      "type": "string",
      "description": "Glob pattern for discovering package.json files",
      "examples": [
        "**/packages/*/package.json",
        "packages/*/package.json",
        "libs/*/package.json"
      ]
    },

    "packages_dir": {
      "type": "string",
      "default": "packages",
      "description": "Directory name containing packages",
      "examples": ["packages", "libs", "modules"]
    },

    "basePath": {
      "type": "string",
      "description": "Base path for resolving files. Defaults to current working directory",
      "examples": [".", "/path/to/monorepo", "../workspace"]
    },

    "access": {
      "type": "string",
      "enum": ["public", "restricted"],
      "default": "restricted",
      "description": "NPM package access level. Use 'public' for scoped packages available to all"
    },

    "dryRun": {
      "type": "boolean",
      "default": false,
      "description": "Run in dry-run mode - perform all steps except actual publication"
    },

    "skipBuild": {
      "type": "boolean",
      "default": false,
      "description": "Skip build steps entirely - useful when packages are already built"
    },
    "testMode": {
      "type": "boolean",
      "default": false,
      "description": "Don't publish packages, don't do any writes"
    },
    "scoped": {
      "type": "boolean",
      "default": false,
      "description": "Publish scoped packages"
    },

    "timeout": {
      "type": "integer",
      "default": 300000,
      "minimum": 10000,
      "maximum": 3600000,
      "description": "Timeout for build and publish operations in milliseconds (10s - 1h)",
      "examples": [300000, 600000, 900000]
    }
  },

  "required": ["packages", "excluded", "excluded_packages", "content"],

  "additionalProperties": false,

  "examples": [
    {
      "packages": ["@fluixi/core", "@fluixi/reactive", "@fluixi/utils"],
      "excluded": ["internal", "examples"],
      "excluded_packages": ["@fluixi/experimental"],
      "content": "**/packages/*/package.json",
      "packages_dir": "packages",
      "type": "patch",
      "tag": "latest",
      "access": "public",
      "global_build": true,
      "package_build": true
    },
    {
      "packages": ["@company/lib-a", "@company/lib-b"],
      "excluded": [],
      "excluded_packages": [],
      "content": "libs/*/package.json",
      "packages_dir": "libs",
      "type": "minor",
      "tag": "beta",
      "suffix": "beta.1",
      "access": "restricted",
      "registry": "https://npm.pkg.github.com",
      "timeout": 600000
    }
  ]
}
